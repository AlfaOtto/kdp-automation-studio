# KDP Automation — Configuration
# Copy this file to .env and fill in your API keys

# Required for AI-powered analysis and content generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — for AI cover image generation with DALL-E
OPENAI_API_KEY=sk-your-key-here

# Amazon region (US, UK, DE, FR, ES, IT, CA, JP — default: US)
AMAZON_REGION=US
